[Unit]
Description=Go Distributed Hashcat Frontend (Vite)
After=network.target
Wants=network.target

[Service]
Type=simple
User=attacker
Group=attacker
WorkingDirectory=/home/attacker/go-distributed-hashcat/frontend
ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0 --port 3004 --strictPort
Restart=always
RestartSec=5
Environment=NODE_ENV=development

[Install]
WantedBy=multi-user.target
